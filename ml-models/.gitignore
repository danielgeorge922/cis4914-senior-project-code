.DS_Store

# Keep folder instructions, not datasets or generated outputs.
/data/raw/*
!/data/raw/readme.txt
/data/processed/*
!/data/processed/readme.txt
/runs/*
!/runs/readme.txt
/exports/*
!/exports/readme.txt

# Prevent accidental commits of model weights elsewhere.
*.pt
*.pth
*.ckpt
*.onnx
*.h5
*.hdf5
*.safetensors
