.venv/
venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.pytest_cache/
.env
.env.*
!.env.example
.DS_Store

# Keep folder instructions, not datasets or generated outputs.
/data/raw/*
!/data/raw/readme.txt
/data/processed/*
!/data/processed/readme.txt
/data/transformed/*
!/data/transformed/readme.txt
/data/manifests/**/*.lock
/data/manifests/**/errors.jsonl
/data/manifests/**/*.tail.bak
/data/manifests/**/*.csv.tmp
/runs/*
!/runs/readme.txt
/exports/*
!/exports/readme.txt

# Prevent accidental commits of model weights elsewhere.
*.pt
*.pth
*.ckpt
*.onnx
*.h5
*.hdf5
*.safetensors
